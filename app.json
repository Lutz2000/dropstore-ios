{
  "expo": {
    "name": "DropStore",
    "slug": "dropstore",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "dropstore",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dropmartug.dropstore",
      "buildNumber": "2",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "DropStore needs access to your photo library to upload product images and profile pictures.",
        "NSCameraUsageDescription": "DropStore needs access to your camera to take photos for products.",
        "NSMicrophoneUsageDescription": "DropStore needs microphone access for video recordings.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dropstore",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://dropstore.click/public/api",
      "eas": {
        "projectId": "6baa36ef-4150-428e-b2d0-9299cc6336f8"
      }
    },
    "owner": "quassim",
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "DropStore needs access to your photo library to upload product images and profile pictures.",
          "cameraPermission": "DropStore needs access to your camera to take photos."
        }
      ]
    ],
    "sdkVersion": "53.0.0"
  }
}