{
  "expo": {
    "name": "DropStore",
    "slug": "dropstore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "dropstore",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dropmartug.dropstore",
      "buildNumber": "2",
      "requireFullScreen": false,
      "infoPlist": {
        "NSCameraUsageDescription": "DropStore needs camera access to take product photos.",
        "NSPhotoLibraryUsageDescription": "DropStore needs photo library access to upload product images.",
        "NSPhotoLibraryAddUsageDescription": "DropStore needs access to save images to your library.",
        "NSLocationWhenInUseUsageDescription": "DropStore uses your location to estimate delivery areas.",
        "NSFaceIDUsageDescription": "Use Face ID to securely sign in to DropStore.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "entitlements": {
        "com.apple.developer.associated-domains": [
          "applinks:dropstore.click"
        ]
      },
      "usesAppleSignIn": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dropstore",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://dropstore.click/public/api",
      "eas": {
        "projectId": "c13a70eb-9848-424b-8d9d-4d6b02a3f878"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "DropStore needs access to your photos to upload product images.",
          "cameraPermission": "DropStore needs camera access to take product photos."
        }
      ]
    ]
  }
}
